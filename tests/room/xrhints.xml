<fireboxroom>
  <assets>
  </assets>
  <room use_local_asset="room_plane" skybox='false'>

    <!-- sky sphere -->
    <object id="sphere" cull_face="front" col='1 0 1' scale='100 100 100'/>

    <!-- occluder xrhint -->
    <object id="plane" js_id="plane"  scale="3 6 1" rotation='0 90 0' class="ar occludable"/>
    
    <!-- equivalent of use_local_asset="room_plane" only in vr & portal -->
    <object id="room_plane" collider_id="cube" collider_scale="100 100 1" class="vr portal"/>

    <!-- should not show up in 'ar' mode -->
    <text text="hello VR" billboard="true"  pos='-2 2 2' col='0 0 0' class='vr portal embed' layer='50'/>
    
    <!-- should not show up in 'vr' mode -->
    <text text="hello AR" billboard="true"  pos='2 2 -2' col='0 0 0' class='ar'/>

    <!-- should only show up in nested room -->
    <object>
      <text text="hello Nested" billboard="true" pos='-2 2 -2' col='0 0 0' class='embed'/>
    </object>

    <!-- should only show up in portal projection -->
    <text text="hello Portal" billboard="true" pos='2 2 2' col='0 0 0' class='portal'/>

  </room>
</fireboxroom>
